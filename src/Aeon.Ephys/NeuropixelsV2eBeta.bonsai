<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:p1="clr-namespace:Aeon.Ephys;assembly=Aeon.Ephys"
                 xmlns:onix1="clr-namespace:OpenEphys.Onix1;assembly=OpenEphys.Onix1"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="rx:SelectMany">
        <Name>NeuropixelsV2eBeta</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>EphysConfig</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>EphysConfig</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>ProbeA</Selector>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Port" Selector="Port" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:ConvertToProbeConfiguration">
                <p1:ProbeName>ProbeA</p1:ProbeName>
                <p1:Port>PortA</p1:Port>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>ProbeAConfig</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>EphysConfig</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>ProbeB</Selector>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Port" Selector="Port" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:ConvertToProbeConfiguration">
                <p1:ProbeName>ProbeB</p1:ProbeName>
                <p1:Port>PortA</p1:Port>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>ProbeBConfig</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ProbeAConfig</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ProbeBConfig</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>GrabContext</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>EphysContext</Name>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>Acquisition</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>EphysConfig</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>BufferSize</Selector>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>ReadBufferSize</Name>
                  </Expression>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="StringProperty">
                      <Value>HeadstageNeuropixelsV2eBeta</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="Name" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>EphysConfig</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="PortVoltage" Selector="PortVoltage" />
                      <Property Name="Port" Selector="Port" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>ProbeAConfig</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="NeuropixelsV2A" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>ProbeBConfig</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="NeuropixelsV2B" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="onix1:ConfigureHeadstageNeuropixelsV2eBeta">
                      <onix1:Name>HeadstageNeuropixelsV2eBeta</onix1:Name>
                      <onix1:NeuropixelsV2A>
                        <onix1:DeviceName>HeadstageNeuropixelsV2eBeta/NeuropixelsV2A</onix1:DeviceName>
                        <onix1:DeviceAddress>256</onix1:DeviceAddress>
                        <onix1:Enable>true</onix1:Enable>
                        <onix1:EnableLed>true</onix1:EnableLed>
                        <onix1:ProbeConfiguration>
                          <onix1:InvertPolarity>true</onix1:InvertPolarity>
                          <onix1:Reference>External</onix1:Reference>
                        </onix1:ProbeConfiguration>
                      </onix1:NeuropixelsV2A>
                      <onix1:NeuropixelsV2B>
                        <onix1:DeviceName>HeadstageNeuropixelsV2eBeta/NeuropixelsV2B</onix1:DeviceName>
                        <onix1:DeviceAddress>257</onix1:DeviceAddress>
                        <onix1:Enable>true</onix1:Enable>
                        <onix1:EnableLed>true</onix1:EnableLed>
                        <onix1:ProbeConfiguration>
                          <onix1:InvertPolarity>true</onix1:InvertPolarity>
                          <onix1:Reference>External</onix1:Reference>
                        </onix1:ProbeConfiguration>
                      </onix1:NeuropixelsV2B>
                      <onix1:Bno055>
                        <onix1:DeviceName>HeadstageNeuropixelsV2eBeta/PolledBno055</onix1:DeviceName>
                        <onix1:DeviceAddress>258</onix1:DeviceAddress>
                        <onix1:Enable>true</onix1:Enable>
                        <onix1:AxisMap>YZX</onix1:AxisMap>
                        <onix1:AxisSign>MirrorY MirrorX</onix1:AxisSign>
                      </onix1:Bno055>
                      <onix1:Port>PortA</onix1:Port>
                      <onix1:PortVoltage>
                        <onix1:Requested>8</onix1:Requested>
                      </onix1:PortVoltage>
                      <onix1:TrackingLed>true</onix1:TrackingLed>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="onix1:StartAcquisition">
                      <onix1:ReadSize>8192</onix1:ReadSize>
                      <onix1:WriteSize>2048</onix1:WriteSize>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>ProbeAConfig</Name>
                  </Expression>
                  <Expression xsi:type="rx:Condition">
                    <Name>ProbeEnabled</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Enable</Selector>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>ReadBufferSize</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="BufferSize" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="rx:SelectMany">
                    <Name>GetProbeA</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="BufferSize" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="onix1:NeuropixelsV2eBetaData">
                            <onix1:DeviceName>HeadstageNeuropixelsV2eBeta/NeuropixelsV2A</onix1:DeviceName>
                            <onix1:BufferSize>3000</onix1:BufferSize>
                            <onix1:OrderByDepth>false</onix1:OrderByDepth>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p1:ConvertToEphysFrame" />
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>ProbeA</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>ProbeBConfig</Name>
                  </Expression>
                  <Expression xsi:type="rx:Condition">
                    <Name>ProbeEnabled</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Enable</Selector>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>ReadBufferSize</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="BufferSize" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="rx:SelectMany">
                    <Name>GetProbeB</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="BufferSize" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="onix1:NeuropixelsV2eBetaData">
                            <onix1:DeviceName>HeadstageNeuropixelsV2eBeta/NeuropixelsV2B</onix1:DeviceName>
                            <onix1:BufferSize>3000</onix1:BufferSize>
                            <onix1:OrderByDepth>false</onix1:OrderByDepth>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p1:ConvertToEphysFrame" />
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>ProbeB</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="onix1:PolledBno055Data">
                      <onix1:DeviceName>HeadstageNeuropixelsV2eBeta/PolledBno055</onix1:DeviceName>
                      <onix1:PolledRegisters>All</onix1:PolledRegisters>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>HeadstageBno055</Name>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="3" To="12" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="12" Label="Source2" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="7" To="12" Label="Source3" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="9" To="12" Label="Source4" />
                  <Edge From="10" To="11" Label="Source1" />
                  <Edge From="11" To="12" Label="Source5" />
                  <Edge From="12" To="13" Label="Source1" />
                  <Edge From="14" To="15" Label="Source1" />
                  <Edge From="15" To="18" Label="Source1" />
                  <Edge From="16" To="17" Label="Source1" />
                  <Edge From="17" To="18" Label="Source2" />
                  <Edge From="18" To="19" Label="Source1" />
                  <Edge From="19" To="20" Label="Source1" />
                  <Edge From="21" To="22" Label="Source1" />
                  <Edge From="22" To="25" Label="Source1" />
                  <Edge From="23" To="24" Label="Source1" />
                  <Edge From="24" To="25" Label="Source2" />
                  <Edge From="25" To="26" Label="Source1" />
                  <Edge From="26" To="27" Label="Source1" />
                  <Edge From="28" To="29" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="3" To="5" Label="Source1" />
            <Edge From="4" To="6" Label="Source1" />
            <Edge From="5" To="6" Label="Source2" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="8" To="10" Label="Source1" />
            <Edge From="9" To="11" Label="Source1" />
            <Edge From="10" To="11" Label="Source2" />
            <Edge From="11" To="12" Label="Source1" />
            <Edge From="13" To="15" Label="Source1" />
            <Edge From="14" To="15" Label="Source2" />
            <Edge From="15" To="16" Label="Source1" />
            <Edge From="16" To="17" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>