<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:p1="clr-namespace:Aeon.Ephys;assembly=Aeon.Ephys"
                 xmlns:onix1="clr-namespace:OpenEphys.Onix1;assembly=OpenEphys.Onix1"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="rx:SelectMany">
        <Name>64ChannelHeadstage</Name>
        <Description>Contains control and acquisition functionality for an ONIX multifunction 64-channel headstage.
</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:Configure64ChannelHeadstageDevices" />
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>EphysConfig</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>BufferSize</Selector>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>EphysConfig</Name>
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>GrabContext</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>EphysContext</Name>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>Acquisition</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>EphysConfig</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>BufferSize</Selector>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>ReadBufferSize</Name>
                  </Expression>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>EphysConfig</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="Bno055" Selector="Bno055" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>EphysConfig</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="TS4231" Selector="Ts4231" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>EphysConfig</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="Rhd2164" Selector="Rhd2164" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>EphysConfig</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="ElectricalStimulator" Selector="ElectricalStimulator" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>EphysConfig</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="OpticalStimulator" Selector="OpticalStimulator" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>EphysConfig</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="Port" Selector="Port" />
                      <Property Name="PortVoltage" Selector="PortVoltage" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="onix1:ConfigureHeadstage64">
                      <onix1:Name>Headstage64</onix1:Name>
                      <onix1:Rhd2164>
                        <onix1:DeviceName>Headstage64/Rhd2164</onix1:DeviceName>
                        <onix1:DeviceAddress>256</onix1:DeviceAddress>
                        <onix1:Enable>true</onix1:Enable>
                        <onix1:DspCutoff>Off</onix1:DspCutoff>
                        <onix1:AnalogLowCutoff>Low100mHz</onix1:AnalogLowCutoff>
                        <onix1:AnalogHighCutoff>High10000Hz</onix1:AnalogHighCutoff>
                      </onix1:Rhd2164>
                      <onix1:Bno055>
                        <onix1:DeviceName>Headstage64/Bno055</onix1:DeviceName>
                        <onix1:DeviceAddress>257</onix1:DeviceAddress>
                        <onix1:Enable>true</onix1:Enable>
                      </onix1:Bno055>
                      <onix1:TS4231>
                        <onix1:DeviceName>Headstage64/Ts4231</onix1:DeviceName>
                        <onix1:DeviceAddress>258</onix1:DeviceAddress>
                        <onix1:Enable>false</onix1:Enable>
                      </onix1:TS4231>
                      <onix1:ElectricalStimulator>
                        <onix1:DeviceName>Headstage64/ElectricalStimulator</onix1:DeviceName>
                        <onix1:DeviceAddress>259</onix1:DeviceAddress>
                        <onix1:Arm>false</onix1:Arm>
                        <onix1:TriggerDelay>0</onix1:TriggerDelay>
                        <onix1:PhaseOneCurrent>0</onix1:PhaseOneCurrent>
                        <onix1:InterPhaseCurrent>0</onix1:InterPhaseCurrent>
                        <onix1:PhaseTwoCurrent>0</onix1:PhaseTwoCurrent>
                        <onix1:PhaseOneDuration>0</onix1:PhaseOneDuration>
                        <onix1:InterPhaseInterval>0</onix1:InterPhaseInterval>
                        <onix1:PhaseTwoDuration>0</onix1:PhaseTwoDuration>
                        <onix1:InterPulseInterval>0</onix1:InterPulseInterval>
                        <onix1:InterBurstInterval>0</onix1:InterBurstInterval>
                        <onix1:BurstPulseCount>0</onix1:BurstPulseCount>
                        <onix1:TrainBurstCount>0</onix1:TrainBurstCount>
                      </onix1:ElectricalStimulator>
                      <onix1:OpticalStimulator>
                        <onix1:DeviceName>Headstage64/OpticalStimulator</onix1:DeviceName>
                        <onix1:DeviceAddress>260</onix1:DeviceAddress>
                        <onix1:Arm>false</onix1:Arm>
                        <onix1:Delay>0</onix1:Delay>
                        <onix1:MaxCurrent>100</onix1:MaxCurrent>
                        <onix1:ChannelOneCurrent>100</onix1:ChannelOneCurrent>
                        <onix1:ChannelTwoCurrent>0</onix1:ChannelTwoCurrent>
                        <onix1:PulseDuration>5</onix1:PulseDuration>
                        <onix1:PulsesPerSecond>50</onix1:PulsesPerSecond>
                        <onix1:PulsesPerBurst>20</onix1:PulsesPerBurst>
                        <onix1:InterBurstInterval>0</onix1:InterBurstInterval>
                        <onix1:BurstsPerTrain>1</onix1:BurstsPerTrain>
                      </onix1:OpticalStimulator>
                      <onix1:Port>PortA</onix1:Port>
                      <onix1:PortVoltage>
                        <onix1:Requested>8</onix1:Requested>
                      </onix1:PortVoltage>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="onix1:StartAcquisition">
                      <onix1:ReadSize>4096</onix1:ReadSize>
                      <onix1:WriteSize>2048</onix1:WriteSize>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>ReadBufferSize</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="BufferSize" Selector="it" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="onix1:Rhd2164Data">
                      <onix1:DeviceName>Headstage64/Rhd2164</onix1:DeviceName>
                      <onix1:BufferSize>3000</onix1:BufferSize>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p1:ConvertToEphysFrame" />
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>ProbeA</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="onix1:Bno055Data">
                      <onix1:DeviceName>Headstage64/Bno055</onix1:DeviceName>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>HeadstageBno055</Name>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="3" To="16" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="16" Label="Source2" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="7" To="16" Label="Source3" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="9" To="16" Label="Source4" />
                  <Edge From="10" To="11" Label="Source1" />
                  <Edge From="11" To="16" Label="Source5" />
                  <Edge From="12" To="13" Label="Source1" />
                  <Edge From="13" To="16" Label="Source6" />
                  <Edge From="14" To="15" Label="Source1" />
                  <Edge From="15" To="16" Label="Source7" />
                  <Edge From="16" To="17" Label="Source1" />
                  <Edge From="18" To="19" Label="Source1" />
                  <Edge From="19" To="20" Label="Source1" />
                  <Edge From="20" To="21" Label="Source1" />
                  <Edge From="21" To="22" Label="Source1" />
                  <Edge From="23" To="24" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>