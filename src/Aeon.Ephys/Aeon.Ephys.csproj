<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Project Aeon - Ephys</Title>
    <Description>Provides reactive modules for ephys acquisition in Project Aeon experiments.</Description>
    <PackageTags>$(PackageTags) Ephys</PackageTags>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <TargetFrameworks>net472</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.bonsai" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Bonsai.Dsp" Version="2.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenEphys.Onix1" Version="0.8.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aeon.Acquisition\Aeon.Acquisition.csproj" />
  </ItemGroup>

</Project>
